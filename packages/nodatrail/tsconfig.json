{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"skipLibCheck": true,
		"outDir": "./",
		"rootDir": "src",
		"importHelpers": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
