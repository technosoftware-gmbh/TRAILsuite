{
  "name": "culitrail",
  "version": "1.0.0",
  "description": "Meals ordered ready-made, as plain Markdown: meal notes, per-person meal planning, and order tracking, for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --project tsconfig.check.json && npm run test:typecheck",
    "build": "npm run typecheck && node esbuild.config.mjs production && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -noEmit -skipLibCheck -p tests/tsconfig.json",
    "version": "node sync-version.js && git add manifest.json"
  },
  "keywords": [],
  "author": "Technosoftware GmbH <support@technosoftware.com> (https://technosoftware.com)",
  "homepage": "https://technosoftware.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technosoftware-gmbh/TRAILsuite.git",
    "directory": "packages/culitrail"
  },
  "bugs": {
    "url": "https://github.com/technosoftware-gmbh/TRAILsuite/issues"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.62.0",
    "conventional-changelog": "^8.0.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "prettier": "^3.5.3",
    "tslib": "^2.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@technosoftware/trail-core": "*"
  }
}
